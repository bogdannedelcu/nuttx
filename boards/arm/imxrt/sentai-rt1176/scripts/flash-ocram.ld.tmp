MEMORY
{
  flash (rx) : ORIGIN = 0x30000000, LENGTH = 3M
  flashxip (rx) : ORIGIN = 0x30300000, LENGTH = 1M
  sram (rwx) : ORIGIN = 0x20240000, LENGTH = 512K
  itcm (rwx) : ORIGIN = 0x00000000, LENGTH = 0K
  dtcm (rwx) : ORIGIN = 0x20000000, LENGTH = 0
}
OUTPUT_ARCH(arm)
EXTERN(_vectors)
EXTERN(g_flash_config)
EXTERN(g_image_vector_table)
EXTERN(g_boot_data)
EXTERN(g_dcd_data)
ENTRY(_stext)
SECTIONS
{
    .boot_hdr : ALIGN(4)
    {
        FILL(0xff)
        __boot_hdr_start__ = ABSOLUTE(.) ;
        KEEP(*(.boot_hdr.conf))
        . = 0x1000 ;
        KEEP(*(.boot_hdr.ivt))
        . = 0x1020 ;
        KEEP(*(.boot_hdr.boot_data))
        . = 0x1030 ;
        KEEP(*(.boot_hdr.dcd_data))
        __boot_hdr_end__ = ABSOLUTE(.) ;
        . = 0x2000 ;
    } > flash
    .flashxip : ALIGN(4)
 {
  FILL(0xff)
  imxrt_start.o(.text)
  imxrt_boot.o(.text)
  *(.slow_memory)
  *(.rodata .rodata.*)
  KEEP(*(__param*))
  *(.fixup)
  *(.gnu.warning)
  *(.gnu.linkonce.t.*)
  *(.glue_7)
  *(.glue_7t)
  *(.got)
  *(.gcc_except_table)
  *(.gnu.linkonce.r.*)
    } > flashxip
    .text :
    {
        _stext = ABSOLUTE(.);
        *(.vectors)
        *(.text .text.*)
        _etext = ABSOLUTE(.);
    } > sram AT > flash
    .init_section :
    {
        _sinit = ABSOLUTE(.);
        *(.init_array .init_array.*)
        _einit = ABSOLUTE(.);
    } > flash
    .ARM.extab :
    {
        *(.ARM.extab*)
    } > sram AT > flash
    .ARM.exidx :
    {
        __exidx_start = ABSOLUTE(.);
        *(.ARM.exidx*)
        __exidx_end = ABSOLUTE(.);
    } > sram AT > flash
    _eronly = ABSOLUTE(.);
    .data :
    {
        _sdata = ABSOLUTE(.);
        *(.data .data.*)
        *(.gnu.linkonce.d.*)
        CONSTRUCTORS
        . = ALIGN(4);
        _edata = ABSOLUTE(.);
    } > sram AT > flash
    .ramfunc ALIGN(4):
    {
        _sramfuncs = ABSOLUTE(.);
        *(.ramfunc .ramfunc.*)
        _eramfuncs = ABSOLUTE(.);
    } > sram AT > flash
    _framfuncs = LOADADDR(.ramfunc);
    .bss :
    {
        _sbss = ABSOLUTE(.);
        *(.bss .bss.*)
        *(.gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = ABSOLUTE(.);
    } > sram
    .stab 0 : { *(.stab) }
    .stabstr 0 : { *(.stabstr) }
    .stab.excl 0 : { *(.stab.excl) }
    .stab.exclstr 0 : { *(.stab.exclstr) }
    .stab.index 0 : { *(.stab.index) }
    .stab.indexstr 0 : { *(.stab.indexstr) }
    .comment 0 : { *(.comment) }
    .debug_abbrev 0 : { *(.debug_abbrev) }
    .debug_info 0 : { *(.debug_info) }
    .debug_line 0 : { *(.debug_line) }
    .debug_pubnames 0 : { *(.debug_pubnames) }
    .debug_aranges 0 : { *(.debug_aranges) }
}
